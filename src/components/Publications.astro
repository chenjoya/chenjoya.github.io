---
import { Image } from 'astro:assets';
import { publications, seedModels, selected, tr, type Lang, type Publication } from '../data/site';
import { ui } from '../i18n';
import { icons } from '../icons';
import { paperImage } from '../lib/images';
import { stars, compact } from '../lib/stars';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const starCounts = Object.fromEntries(await Promise.all(publications.filter((p) => p.repo).map(async (p) => [p.repo!, await stars(p.repo!)])));
const authors = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!).replace(/Joya Chen(\*?)/, '<span class="me">Joya Chen$1</span>');
const searchText = (p: Publication) => `${p.title} ${p.authors} ${p.venue} ${p.year} ${tr(p.note, 'en')} ${tr(p.note, 'zh')}`.toLowerCase();
const seedAt = publications.findIndex((p) => p.seed);
const seedPubs = publications.filter((p) => p.seed);
const count = { selected: selected.length, all: publications.length };
---

<section id="research">
  <div class="sec-h">
    <h2>{t.research}</h2>
    <div class="tools">
      <div class="seg" role="tablist" aria-label={t.research}>
        <span class="seg-ind"></span>
        <button type="button" role="tab" data-f="selected" aria-selected="true">{t.selected}<span>{count.selected}</span></button>
        <button type="button" role="tab" data-f="all" aria-selected="false">{t.all}<span>{count.all}</span></button>
      </div>
      <label class="search">
        <Fragment set:html={icons.search} />
        <input id="q" type="search" placeholder={t.filter} aria-label={t.filter} autocomplete="off" />
        <kbd>/</kbd>
      </label>
    </div>
  </div>
  <ul class="list" id="pubs">
    {
      publications.map((p, i) => (
        <>
          {i === seedAt && (
            <li class="pub" data-sel="true" data-all="false" data-search="">
              <button class="pub-row" type="button" aria-expanded="false">
                <Image class="pub-thumb" src={paperImage(seedModels.img)} width={120} alt="" />
                <span>
                  <span class="pub-title">{tr(seedModels.title, lang)}</span>
                  <span class="pub-authors">{seedModels.members}</span>
                </span>
                <span class="pub-meta">
                  {seedModels.years}
                  <span class="chev" />
                </span>
              </button>
              <div class="pub-detail">
                <div>
                  <div class="pub-detail-inner">
                    <p>{tr(seedModels.note, lang)}</p>
                    <div class="pub-links">
                      {seedPubs.map((s) => (
                        <a href={s.url} target="_blank" rel="noopener">
                          {s.title.replace(/ (Model Card|Technical Report)$/, '').replace(/:.*$/, '')}
                          <Fragment set:html={icons.arrow} />
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </li>
          )}
          <li class="pub" data-sel={String(selected.includes(p.id))} data-all="true" data-search={searchText(p)} hidden={!selected.includes(p.id)}>
            <button class="pub-row" type="button" aria-expanded="false">
              <Image class="pub-thumb" src={paperImage(p.img)} width={120} alt="" />
              <span>
                <span class="pub-title">{p.title}</span>
                <span class="pub-authors" set:html={authors(p.authors)} />
              </span>
              <span class="pub-meta">
                {p.venue}
                {p.award && <span class="award"> {p.award}</span>} {p.year}
                <span class="chev" />
                {p.repo && starCounts[p.repo] != null && (
                  <>
                    <br />
                    <span class="star" title={`${starCounts[p.repo]} GitHub stars`}>
                      <Fragment set:html={icons.star} />
                      {compact(starCounts[p.repo]!)}
                    </span>
                  </>
                )}
              </span>
            </button>
            <div class="pub-detail">
              <div>
                <div class="pub-detail-inner">
                  <figure>
                    <Image src={paperImage(p.img)} widths={[560, 1120]} sizes="(max-width: 640px) 100vw, 560px" quality={72} alt={p.title} />
                  </figure>
                  <p set:html={authors(p.authors)} />
                  {p.note && <p>{tr(p.note, lang)}</p>}
                  <div class="pub-links">
                    {p.links.map((l) => (
                      <a href={l.url} target="_blank" rel="noopener">
                        {l.label}
                        <Fragment set:html={icons.arrow} />
                      </a>
                    ))}
                    {p.repo && (
                      <a href={`https://github.com/${p.repo}`} target="_blank" rel="noopener">
                        <Fragment set:html={icons.github} />
                        {p.repo}
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </li>
        </>
      ))
    }
  </ul>
  <p class="empty" hidden>{t.noMatch}</p>
  <p class="fine">{t.researchNote}</p>
</section>

<script>
  import '../scripts/research';
</script>
